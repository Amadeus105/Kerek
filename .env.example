# Скопируй в .env и заполни. Пустые ключи = демо-режим.

# AliExpress Affiliate API: portals.aliexpress.com -> Tools -> API
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# DeepL API Free: deepl.com/pro-api (500 000 символов в месяц бесплатно)
DEEPL_KEY=

# Наценка к цене в процентах (доставка, комиссия)
MARKUP_PERCENT=0
